rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == 'vinizac@hotmail.com'; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function role() { return hasProfile() ? get(userPath()).data.role : 'none'; }
    function active() { return isOwner() || role() in ['viewer', 'editor', 'admin']; }
    function isAdmin() { return isOwner() || role() == 'admin'; }
    function canEdit() { return isOwner() || role() in ['editor', 'admin']; }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isOwner() || (signedIn() && request.auth.uid == userId && request.resource.data.role == 'pending');
      allow update, delete: if isAdmin();
    }
    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['versions','prs','issues','regressionTests','knowledgeArticles','auditLogs'] && active();
      allow create, update: if collectionName in ['versions','prs','issues','regressionTests','knowledgeArticles'] && canEdit();
      allow delete: if collectionName in ['versions','prs','issues','regressionTests','knowledgeArticles'] && isAdmin();
    }
  }
}
